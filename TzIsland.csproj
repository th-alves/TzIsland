<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TzIsland</AssemblyName>
    <RootNamespace>TzIsland</RootNamespace>
    <Version>2.8.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TzIsland.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <TieredPGO>true</TieredPGO>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;CS8618</NoWarn>
    <!-- Velopack (vpk): empacota publish/ como instalador + atualizações -->
    <VpkPackId>TzIsland</VpkPackId>
    <VpkPackTitle>TzIsland</VpkPackTitle>
    <VpkPackAuthors>Thigas</VpkPackAuthors>
    <VpkMainExe>TzIsland.exe</VpkMainExe>
    <VpkChannel>win</VpkChannel>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF + WinForms juntos geram conflitos de nomes: removemos os usings implícitos do WinForms -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Inter (OFL): fonte moderna embutida, não depende de nada instalado no Windows -->
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\TzIsland.ico" />
    <None Include="Fonts\LICENSE-Inter.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- A ferramenta `vpk` (empacotador) não é referência de pacote: instale com
         dotnet tool install vpk (tool-path tools) e use tools\vpk.exe pack; ver docs/VELOPACK.md -->
  </ItemGroup>

</Project>
